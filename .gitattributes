# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicit text files
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.h text eol=lf
*.cpp text eol=lf
*.ino text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.txt text eol=lf
.gitignore text eol=lf

# Binary files
*.tflite binary
*.h5 binary
*.npz binary
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
